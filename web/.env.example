LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
AI_MODE=on
AI_DAILY_CAP=300
AGENT_TIMEOUT_MS=25000
# Optional fallback: enabled only when LLM_FALLBACK_API_KEY is set. Same DeepSeek model on Mistral.
# Mistral rejects unknown fields, so reasoning_effort and x-opencode-session are not sent there.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.mistral.ai/v1
LLM_FALLBACK_MODEL=deepseek-v4-1-flash-1017
# Idle timeout while waiting for the next streamed chunk (ms).
LLM_STREAM_IDLE_MS=15000
