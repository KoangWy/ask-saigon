LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
AI_MODE=on
AI_DAILY_CAP=1000
# Live AI answers per browser and per IP in each 10-minute window.
AI_PER_BROWSER=40
AI_PER_IP=300
AGENT_TIMEOUT_MS=25000
# Mistral serves the same DeepSeek model 3-5x faster per turn, so it goes first when its key is set;
# OpenCode Go (above) is then the fallback. Mistral rejects unknown fields, so reasoning_effort and
# x-opencode-session are not sent there. The older LLM_FALLBACK_* names still work.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=deepseek-v4-1-flash-1017
# Idle timeout while waiting for the next streamed chunk (ms).
LLM_STREAM_IDLE_MS=15000
# Set to opencode to try OpenCode Go first and keep Mistral as the fallback.
LLM_PRIMARY=
